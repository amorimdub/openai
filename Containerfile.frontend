FROM oven/bun:1.4.0 AS build
WORKDIR /app/frontend
COPY src/frontend/package.json src/frontend/bun.lock ./
RUN bun install --frozen-lockfile
COPY src/frontend/ ./
RUN bun run build

FROM oven/bun:1.4.0
WORKDIR /app
COPY --from=build /app/frontend/dist ./frontend
COPY scripts/serve-frontend.ts ./serve-frontend.ts
ENV FRONTEND_DIST=/app/frontend
ENV HOST=0.0.0.0
ENV PORT=4173
EXPOSE 4173
CMD ["bun", "run", "serve-frontend.ts"]
