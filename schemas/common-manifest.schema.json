{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "enum": [
        "CC-BY-4.0",
        "CC0-1.0",
        "CC-BY-SA-4.0",
        "ODbL-1.0",
        "public-domain",
        "custom-reuse",
        "unverified"
      ]
    },
    "licenseEvidenceUrl": {
      "type": "string",
      "format": "uri"
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "reuseStatus": {
      "type": "string",
      "enum": [
        "approved",
        "unverified",
        "restricted"
      ]
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "observedPeriod": {
      "type": [
        "string",
        "null"
      ]
    },
    "geography": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "string",
      "enum": [
        "partial",
        "unknown"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "rawAssets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "format": {
      "type": "string",
      "const": "ndjson"
    },
    "quality": {
      "type": "object",
      "properties": {
        "inputRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quarantinedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unlocatedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excludedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exclusions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "inputRecords",
        "acceptedRecords",
        "quarantinedRecords",
        "unlocatedRecords",
        "excludedRecords",
        "exclusions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "snapshotId",
    "sourceId",
    "scope",
    "publisher",
    "sourceUrl",
    "license",
    "licenseEvidenceUrl",
    "attribution",
    "reuseStatus",
    "fetchedAt",
    "observedPeriod",
    "geography",
    "coverage",
    "limitations",
    "adapter",
    "rawAssets",
    "recordCount",
    "sha256",
    "format",
    "quality"
  ],
  "additionalProperties": false
}
