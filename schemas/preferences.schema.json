{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "location": {
      "type": "object",
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -11,
          "maximum": -5
        },
        "latitude": {
          "type": "number",
          "minimum": 51,
          "maximum": 56
        },
        "placeId": {
          "type": "string"
        }
      },
      "required": [
        "longitude",
        "latitude"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "type": "string",
            "enum": [
              "required",
              "preferred"
            ]
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "parameters": {
            "default": {},
            "type": "object",
            "properties": {
              "maximumMinutes": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mode": {
                "type": "string",
                "enum": [
                  "driving",
                  "walking",
                  "cycling",
                  "public_transport"
                ]
              },
              "maximumDistanceM": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "childAge": {
                "type": "number",
                "minimum": 0,
                "maximum": 18
              },
              "facilityId": {
                "type": "string"
              },
              "requiredService": {
                "type": "string"
              },
              "maximumAmountEur": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "bedrooms": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "minimumDownloadMbps": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "importance",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "radiusKm": {
      "default": 10,
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 50
    }
  },
  "required": [
    "version",
    "location",
    "criteria",
    "radiusKm"
  ],
  "additionalProperties": false
}
