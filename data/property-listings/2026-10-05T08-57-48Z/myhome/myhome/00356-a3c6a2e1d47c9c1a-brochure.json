    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nNo. 9 Brook Lodge House offers an ideal opportunity to acquire a 1 bed apartment in this most sought after location.\n\nLocated just minutes' walk from Tralee Town Centre, Oakview Village offers residents a highly sought-after and convenient location with every amenity on the doorstep.\n\nWith the benefit of a south east facing aspect and with direct access to patio and a well maintained green area this apartment will impress all those seeking a quality ground floor apartment.\n\nThe property is finished to a high standard throughout with a modern interior and ample parking to the front.\n\n Oakview Village itself is immaculately presented with all common areas and green areas in pristine condition throughout."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - 3.76 x 1.37\n\n\nHot Press - 0.92 x 1.15\n\n\nLiving Room - 7.04 x 3.3\n\n\nBedroom 1 - 3.56 x 3.1\n\n\nBathroom - 2.31 x 1.88\n\n\n"
