    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Fantastic 2 bedroom mid terrace bungalow located in Prospect Avenue comes to the market in excellent condition throughout. Within minute’s walking distance to the heart of Drogheda Town Centre, the property is surrounded with a wealth of amenities and services including shops, restaurants, schools, and other transport services. This house has all the ingredients for the discerning first time buyer or equally, anyone who requires a property that is in very good condition."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance Hall\r\nLiving Room\t\t(4.72m x 3.25m)\r\nKitchen\t\t(2.31m x 4.72m)\r\nBedroom 1\t\t(4.13m x 2.66m)\r\nBedroom 2\t\t(3.07m x 2.83m)\r\nBathroom \t\t(2.45m x 1.85m)"
      },
      {
