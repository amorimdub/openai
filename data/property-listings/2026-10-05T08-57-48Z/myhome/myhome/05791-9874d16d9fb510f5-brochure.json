    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Excellent three bed semi-detached property ideally located in the village of Ardfinnan and within easy access to Cahir just 10 minutes and Clonmel 20 minute’s drive. The property is within walking distance of the local creche, shop, church and primary school and just five minutes to the GAA playing field & all-weather pitch.\r\nIt is in good condition throughout and has oil fired heating, double glazed windows & doors and a solid fuel stove. The property has a side access to rear enclosed garden."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance hall with tiled floor & wc \r\nSitting room with timber floor and solid wood stove\r\nKitchen with fitted units, integrated appliances, dining area and patio door to rear garden\r\nFirst floor-\r\nBedroom one/ office with fitted robes\r\nBedroom two with fitted robes\r\nBedroom three with fitted robes & en suite\r\nBathroom fully tiled with shower over bath"
      },
