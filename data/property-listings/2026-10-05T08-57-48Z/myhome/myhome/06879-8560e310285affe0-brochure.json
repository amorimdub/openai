      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "Travel outbound on Magazine Road towards Dennehy's Cross. The property is located on the left-hand side, just past the entrance to Lima Lawn. See for sale sign on the left hand side."
      }
