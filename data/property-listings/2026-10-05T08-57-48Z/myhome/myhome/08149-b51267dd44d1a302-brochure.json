    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nNumber 68 Hilltown Park is an excellent semi detached family residence, ideally located in the mature and highly sought after development of Rivervalley, convenient to Swords and all local amenities. \n\nAccommodation comprises entrance hallway, spacious lounge, and open plan kitchen/dining room. Upstairs there are three large bedrooms, and family bathroom.\n\nLow walled garden to front with concrete driveway and ample parking. Walled garden to rear with trees and shrubbery.\nThe property overlooks a green area and is within walking distance Swords Main Street and a host of local shopping, leisure and transport amenities. Dublin Airport, and the M50/M1 motorways are close by. Viewing is recommended."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - 2.80m x 4.80m\nWood flooring, understairs storage and stairs to first floor landing.\n\nLounge - 4.80m x 3.80m\nWide plank wood flooring, feature tiled fireplace, built in bookcase, large double glazed window to front.\n\nKitchen/Dining - 5.70m x 3.50m\nFitted units, tiled splashback, wooden flooring. Two double glazed windows to rear.\n\nUPSTAIRS - \n\n\nLanding - 3.20m x 4.20m\nHot press, access to attic and frosted double glazed window to side.\n\nBedroom 1 - 3.80m x 3.60m\nBuilt in wardrobes, double glazed window to front.\n\nBedroom 2 - 3.80m x 3.40m\nBuilt in wardrobes, double glazed window to rear.\n\nBathroom - 2.0m x 1.80m\nBuilt in wardrobes, double glazed window to rear.\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Semi detached family residence</li><li>Mature and sought after estate</li><li>Spacious lounge</li><li>Open plan kitchen/dining room</li><li>Three bedrooms</li><li>Driveway parking </li><li>Large rear garden with concrete shed</li><li>Walking distance Swords Main Street and all local amenities</ul>"
      },
