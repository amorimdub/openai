    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Campbells Auctioneers are delighted to present this parcel of land to the open market, occupying an elevated position in the scenic coastal area of Dooey, Lettermacaward.\n\nSituated just moments from the stunning Dooey Beach, the lands enjoy a spectacular setting along one of West Donegal`s most beautiful stretches of coastline. \n\nRenowned for its golden sands, rolling dunes and excellent surfing conditions, Dooey Beach has become a popular destination for surfers, walkers and outdoor enthusiasts alike\n\n \n\nFor further information or to arrange a viewing of the lands, contact Campbells Auctioneers.\n\nOur Ref: K1276"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Notice\nPlease note we have not tested any apparatus, fixtures, fittings, or services. Interested parties must undertake their own investigation into the working order of these items. All measurements are approximate and photographs provided for guidance only."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> Excellent Residential Site Potential (STPP) </li><li> Close to Dooey Beach </li><li> 5 Minutes from Lettermacaward</li></ul>"
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Kenneth Campbell"
      }
    ],
