    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Derelict Cottage on 0.75 acre FOR SALE ; this cottage needs complete renovation throughout, and is located in a quiet  rural location with outstanding sea view of Courtmacsherry Bay . Currently the cottage is situated on level site in  surrounding fields .\r\nThe cottage has been derelict for over 30 years . \r\nBuilding grants may be available on this property .\r\nThe property is walking distance to local beaches and to local restaurant ."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Kilbrittain village is within 5 minutes' drive . Primary school is with in 5 minutes drive. Local shops and Pubs are close by. \r\nBandon and Kinsale and Clonakilty are within 20 minutes' drive .\r\nCork city and Airport are within 40 minutes' drive."
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Call Roy Lee for viewings ."
      }
