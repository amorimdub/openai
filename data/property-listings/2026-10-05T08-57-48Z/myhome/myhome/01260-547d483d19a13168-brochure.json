    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "To Rent, this fully furnished, bright and modern 2 bedroom, apartment in a secure and popular town center apartment complex.\r\nAttractive and De-Luxe apartment offering turn key finish within walking distance of all town amenities and having the benefit of a rooftop garden which offers panoramic views over the town of Dundalk.\r\nThe apartment which has a bright and modern lay-out comprises entrance hall, living room, fully fitted kitchen two bedrooms (both ensuite) and guest bathroom.\r\nThis spacious apartment offers total convenience, being located in the heart of the town, within walking distance of all amenities and within easy access of bus terminus and train station. *Strictly No Pets* Photographs for Identification Purposes Only"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Town centre - quiet and secure location\r\nLift access\r\nTurn key finish\r\nRooftop gardens\r\nConvenient to all town centre amenities"
      },
