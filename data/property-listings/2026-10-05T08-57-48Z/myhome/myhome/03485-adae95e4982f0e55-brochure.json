    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nNo. 47 Ridgepool Village boasts a fantastic location close to the River Moy, the famous Ridge Pool and Ballina town.\n\nThis light filled 2-bedroom apartment has its own door access along the River Moy. It is located within Ballina town along the River Moy - famous for its salmon fishing and close to shops, pubs, churches, restaurants, schools, crèche and post offices.\n\nAccommodation comprises entrance porch, spacious living/dining room with open fire, kitchen, two bedrooms and bathroom. Store room outside under the stairs. Ample car parking available within the complex and connected to all mains services with electric storage heating.\n\nEarly viewing recommended."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - 1.36m x 1.67m\n\n\nReception Room - 5.10m x 5.25m\nWith open fireplace\n\nKitchen - 2.37m x 2.82m\n\n\nBedroom 1 - 3.38m x 2.28m\nWith Built in Wardrobes\n\nBedroom 2 - 3.52m x 2.71m (3.53m x 2.72m\nWith Built in Wardrobes\n\n"
      },
