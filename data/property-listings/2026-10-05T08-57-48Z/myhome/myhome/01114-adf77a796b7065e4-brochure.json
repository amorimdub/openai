    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nDelightful fully refurbished two bedroomed ground floor apartment circa 64sq.m. - 689sq. ft. with lounge, kitchen, bathroom with separate shower unit. In mature block of apartments just minutes' walk to Rathfarnham Village with excellent open space in the grounds of the Historic Rathfarnham Castle. \n\nConvenient to all local shops, and excellent public transport (routes 15B,16,74 S6) and many sporting and leisure amenities. There is an electric thermostatically controlled heating system & recently installed double glazed windows and doors. Car parking is by way of permit in gated car park."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall via Sun Lounge - 3.1m x 2.0m\nTiled floor & storage press, leading to lounge\n\nLounge - 4.6m x 4.5m\nWith with porcelain tiled floor, leading to...\n\nKitchen - 3.1m x 2.3m\nLarge selection of bespoke fitted kitchen unitswith larder unit, neff oven, whirlpool microwave, Hotpoint hob, extractor, dishwasher, washer/dryer & fridge/freezer, tiled floor & glass panel backsplash\n\nHallway/Lobby - \nWith hot-press & storage press\n\nShower Room - 2.0m x 1.8m\nWith walk-in raindrop power shower, tiled floors & walls\n\nBedroom 1 - 4.6m x 2.5m\nWith fitted wardrobes\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> Management Fees - circa 1,400 p.a.</li><li> Electric Thermostatically Controlled Heating System</li><li> Double Glazed Window & Patio Doors</li><li> Wired for Burglar Alarm</li><li> Porcelain Tiled Floors to Lounge, Kitchen</li><li> Panel Doors Throughout</li><li> Downlighters</li><li> Telephone & Cable TV available</li><li> Intercom</li><li> Permit Car Parking</li><li> Floor Area Circa 64 sq.m. - 689 sq.ft.</ul>"
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: C3\nBER No: 101032050\nEnergy Performance Indicator: 202.86"
      },
