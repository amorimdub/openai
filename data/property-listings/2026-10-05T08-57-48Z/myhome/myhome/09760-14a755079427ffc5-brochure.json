    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "The site is approx. half an acre with outline planning permission granted for the construction of a private dwelling, effluent treatment plants with pecolation area, adjustment to existing entrance to form recessed entrance drive with piers, gates and splayed wall and all ancillary site works. There are a number of conditions attached to the original permission granted and the subsequent bord pleanala decision."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Residential Site For Sale With Outlined Planning Permission.\r\nSite with outlined planning permission\r\nClose proximity to Limerick City and Northern Relief Road.\r\nQuiet rural setting"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "The property is situated on the Pass road in Meelick, Limerick. The most direct route is to travel from Limerick City along the Condell road onto the new Northern Relief Road and continue to the Old Cratloe road junction, then you take the first left passing the Country Club pub and then take your next right. After the next small mini roundabout the site is on the right hand side with a for sale sign erected thereon."
      },
      {
