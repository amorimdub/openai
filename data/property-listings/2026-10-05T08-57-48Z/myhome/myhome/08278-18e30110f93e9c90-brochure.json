    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Circa 3 Acre Site for Sale with Full Planning Permission\r\n\r\nSinead Coughlan is delighted to bring to the market a C.3 Acre site with Full Planning permission in Place to build a 4 bedroom Style Home in a country setting. No Occupancy Clause. There is a School and Creche in the village, and the site is just minutes from Clonshire and Adare Village with all amenities Adare has to offer. It is a short drive to Raheen Buisness Park, Limerick City,  Limerick University and Shannon airport.\r\nFor Further maps and particulars, contact Sinead Coughlan 087-4050663."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Approved Planning permission to build a 4 bedroom Dwelling."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Large 3 acre site with Full planning permission in place for a 4 bedroom single dwelling.\r\nNo Occupancy Clause.\r\nEstablished Local Amenities Nearby, School and Creche in Village\r\nMinutes from The Picturesque Village of Clonshire and Adare. \r\nExcellent Connectivity to Limerick City and Shannon airport."
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "For further information call Sinead Coughlan Estate Agent 087- 4050663"
      }
