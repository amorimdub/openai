    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nInterested in this property? Sign up for mySherryFitz to arrange your viewing, see current offers, or make your own offer. Register now at SherryFitz.ie.\n\nSherry FitzGerald O'Donovan present to market this ideally located two-bedroom, first floor apartment situated directly in the heart of Midleton.\n\nAccommodation briefly comprises of an entrance hall, an open plan kitchen/living room, a bathroom, and two bedrooms.\n\nThe property is ideally located as it is in the heart of the town and within walking distance of all local amenities in Midleton. It is only a 25-minute commute to both Cork City and Fermoy, and being under 20 minutes to Cobh, Cloyne, Carrigtwohill, and Castlemartyr.\n\nEarly viewings for this property are advised."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hallway - \nWood Flooring\n\nKitchen - 2.7m x 2.0m\nTiled\n\nLiving Room - 5.1m x 2.2m\nWood Flooring\n\nBathroom - 1.8m x 1.5m\nTiled, Electric Shower\n\nBedroom 1 - 3.4m x 2.1m\nWood Flooring\n\nBedroom 2 - 2.4m x 2.4m\nWood Flooring\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>2 Bedroom, 1 Bathroom, First Floor Apartment</li><li>Located in Midleton Town Centre</li><li>D2 BER</li><li>Built in 1920</li><li>36 Square Meters</li><li>Mains Services</li><li>Electric Storage Heating</ul>"
      }
