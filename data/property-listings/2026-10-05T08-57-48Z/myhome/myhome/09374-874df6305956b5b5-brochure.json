    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "A delightful period townhouse residence in a mature and prestigous location in the heart of Dublin 4, conveniently located close to all major sporting venues, beside local shopping and within very easy commuting distance of St. Stephen's Green/Grafton Street and the central business and professional addresses. The property retains most of its period features including window shutters, architraves, plaster work and timber work and white marble chimney pieces, but is in need of modernisation and upgrading.."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance Hall, Drawing Room 5.49 m.  x  5.11 m., Siotting Room 4.67 m.  x  4.57 m., Study or 4th Bedroom 34.20 m.  x  3.12 m., Porch Entrance and Large interior hallway at garden level, Dining Room 5.33 m.  x  4.93 m., Kitchen with new Aga Cooker 4.57 m.  x  4.34 m., Utility Room 2.92 m.  x  2.67 m., Shower/WHB/WC., Bedroom 1 4.72 m.  x  4.50 m., Bedroom 2 5.30 m.  x  4.04 m., Bedroom 3 4.04 m.  x  2.97 m., Bathroom/WC with Twin WHBs , Long Railed Garden in front, Walled Garden at rear."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
