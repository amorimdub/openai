    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nWell-maintained three bedroom detached bungalow, nicely set back from the road on a large 1.5 acre site. This property comes to the market in good condition, and is well located just 2km from Foxford and less than 15km from Ballina town. It is set back from the main N26 road on a large, mature and well-defined site, with spacious gardens and mature trees.The house boasts two large reception rooms, three bedrooms, a kitchen, living room and family bathroom.To see current offers or place your own offer on this property, please visit SherryFitz.ie and register for your mySherryFitz account."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nHallway - 1.6m x 4m\nWith tile floor.\n\nSitting Room - 4.0m x 4.2m\nWith carpet floor and open fireplace.\n\nKitchen - 3.6m x 2.4m\nWith tile floor, fitted kitchen and a door leading to the rear garden.\n\nLiving Room - 4.3m x 3.7m\nWith tile floor and Oil range\n\nBedroom 1 - 3.2m x 3.0m\nDouble room to the front of the house with carpet floor.\n\nBedroom 2 - 3.5m x 4.2m\nDouble room to the rear of the house with carpet floor.\n\nBedroom 3 - 3.1m x 2.4m\nDouble room to the rear of the house with carpet floor.\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Large 1.5 acre mature site. </li><li>Block Built Shed to Rear. </li><li>Double Glazed Windows. </li><li>Oil-Fried Central Heating.</li><li>2-kilometers from Foxford.</ul>"
      },
