    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "No. 14 Clonuske Drive, Balbriggan is a spacious 2 bedroom top floor(2nd floor-with large Attic) apartment within minutes walk of the Castlemill Shopping centre and close to Balbriggan town centre. This spacious property is situated in a mature well settled estate just off Hamlet lane. The property has a livingroom, kitchen, Attic storage, 2 bedrooms and a bathroom. The apartment is well located with ample on street parking. Located off Hamlet Lane, the property is close to all local amenities including excellent shopping facilities, schools and a good public transport infrastructure with Bus Eireann, Dublin Bus and suburban rail access to Dublin City Centre (c. 45 mins) being only minutes away. The M1 is close-by allowing easy access to all areas of the city and also to the North of Ireland."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Livingroom\t5.33m X 2.9m\twith double doors to balcony. \r\nKitchen\t3.24m X 1.9m\twith attractive fitted presses. \r\n\r\nBedroom 1       3m  X 2.85m\twith fitted wardrobes.  \r\nBedroom 2\t4m X 2.37m\twith fitted wardrobes. \r\nBathroom\t3m   X 1.93m\t with bath, wc, whb."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Gas Fired Central Heating.\r\nUpvc Double glazed windows.\r\nDesignated car space with ample visitor spaces.\r\nWithin a short walk of Balbriggan Town Centre."
      },
      {
