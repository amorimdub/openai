    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Impressive four bedroom detached family residence superbly located in Milltown Village. Ths bright and spacious property is in excellent condition within walking distance of Milltown National School, Drumlane G.A.A. Grounds and Creche and Community Centre\r\nProperty comes to the market with vacant possession and ready for occupation.\r\nExcellent garden to both front and rear."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Ground floor:\r\nRec Hall 4.5m x 2.0m – tiled floor\r\nSitting Room 4.3m x 4.0m with solid fuel fireplace\r\nKitchen/Dining Room 6.7m x 4.0m – Fully fitted\r\nBedroom (1) 4.0m x 3.1m\r\nBedroom (2) 3.7m x 3.5m\r\nBathroom 2.7m x 2.1m – fully Tiled\r\nIncorporated Garage 6.0m x 4.2m (Part used as utility)\r\n\r\nFirst Floor:\r\nSpacious Landing and Hot Press 3.9m x 2.9m\r\nMaster Bedroom 4.8m x 3.5m plus en-suite 2.0m x 1.5m and walk in wardrobe 4.0m x 2.4m\r\nBedroom (4) 4.8m x 4.0m"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "O.F.C.H. throughout\r\nTarmac Driveway\r\nU.P.V.C. Windows and Doors\r\nGarage Suitable for Conversion\r\nSeptic Tank Sewerage system on site\r\nGroup Scheme Water Supply\r\nLow Maintenance Exterior\r\nFootpath to Village, School, GAA Grounds, Childcare Creche, Cummunity Centre and Playground"
      },
      {
