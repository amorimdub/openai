    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nDNG O'DWYER ARE HAPPY TO PRESENT TO THE MARKET THIS DERELICT FARMHOUSE ON 2.65 ACRES ONLY 3 KM FROM CAVAN TOWN."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> Welcome to this period derelict farmhouse located in a picturesque and highly desirable location close to Cavan town.</li><li> This property provides the opportunity for prospective buyers to acquire a property with potential for refurbishment and extension.</li><li> This charming period detached house is nestled in a tranquil rural setting in County Cavan, offering a perfect blend of affordability, privacy and natural beauty.</li><li> Set on an expansive 2.65-acre site, the property enjoys a scenic and secluded location that promises peace and quiet away from the bustle of town life.</li><li> The property is an established farmhouse that has been derelict for some time and suitable for application for the Vacant Property Refurbishment Grant (often funded via the Croí Cónaithe scheme) under this government initiative, you can receive up to 70,000.</ul>"
      },
