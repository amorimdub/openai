    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nBeautifully presented four bedroom semi detached home situated on a favourable south facing position in Tor Bui, a convenient and highly sought-after development of just 41 homes in Knocknacarra within walking distance of Cappagh Park and the scenic Rusheen Bay.\n\nBuilt circa 2001 by O'Malley Construction, number 27 is a spacious home with the accommodation thoughtfully laid out with well-proportioned rooms throughout, comprising of a bright entrance hall, living room with bay window and an open fire, separate dining room, spacious kitchen breakfast room, utility and a guest WC. Upstairs, there are four generously sized bedrooms, one of which is ensuite, and all with built in or fitted wardrobes. The main bathroom is very well finished and completes the accommodation. \n\nThis home is ready for immediate use offering a turnkey opportunity in a quiet, established neighbourhood with superb location close to parks, recreational amenities and coastal walks."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall: - \nTiled floor, coved ceiling, storage.\n\nLiving Room: - \nCarpet flooring, bay window, solid fuel fire with granite fireplace, coved ceiling, French doors to dining room.\n\nKitchen: - \nTiled floor, built in kitchen with south facing rear aspect window, electric cooker, plumbed for dishwasher.\n\nDining Room: - \nCarpet flooring, coved ceiling, French patio doors to private, south facing rear garden.\n\nUtility Room: - \nTiled floor, built in storage, plumbed for washing machine, side door.\n\nGuest WC: - \nTiled floor, WC, wash hand basin, side aspect window.\n\nBedroom 1: - \nTimber floor, front aspect window with Juliet balcony, built in wardrobe, tv point.\n\nEn-Suite: - \nFully tiled, WC, wash hand basin, electric shower.\n\nBedroom 2: - \nCarpet flooring, fitted wardrobe, rear aspect window.\n\nBedroom 3: - \nCarpet flooring, fitted wardrobe, rear aspect window.\n\nBedroom 4: - \nCarpet flooring, fitted wardrobe, front aspect window.\n\nBathroom: - \nFully tiled, WC, wash hand basin, bath with shower, side aspect window.\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Excellent location</li><li>South facing rear garden</li><li>Beautifully presented</li><li>Double glazed PVC windows</li><li>Oil fired central heating</ul>"
      },
