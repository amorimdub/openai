    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nNo. 8 Rosehill Avenue is a beautifully proportioned, three-bedroom townhouse ideally nestled in the heart of Firies Village. Spanning approximately 75 m², this modern home balances bright modern living spaces with an incredibly convenient location. Perfect as a turnkey first-time purchase, a low-maintenance downsizing option, or an astute investment property, No. 8 offers an idyllic lifestyle within easy commuting distance of Killarney, Tralee, and Killorglin."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - 2.16m x 2.46m\nTiled floor\n\nKitchen / Living - 4.31m x 5.94m\nTiled floor, open fireplace, fitted kitchen\n\nBedroom - 2.26m x 2.58m\nTiled floor\n\nUtility Room - 1.41m x 2.47m\nTiled floor, rear door\n\nWC - 1.01m x 1.38m\nTiled floor, WC, WHB\n\nMaster Bedroom - 3.28m x 5m\nTimber floor, built in wardrobe\n\nEn Suite - 2.31m x 0.84m\nTiled, WC, WHB., shower\n\nBedroom - 3.55m x 2.47m\nTimber floor\n\nBathroom - 2.25m x 2.79m\nNewly renovated bathroom with tiling, WC, WHB, Shower\n\n"
      },
