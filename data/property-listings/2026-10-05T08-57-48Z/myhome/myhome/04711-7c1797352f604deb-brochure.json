    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nTown centre living with ground floor bedroom and shower room!This deceptive 2 bed end of terrace property boasts a town centre location with all amenities literally on your doorstep.Stepping into the property, there is a spacious living room to the front with a window to the main street. To the rear there is a kitchen/dining room extension with fitted units and a sliding glass door to the rear yard. The rear hall continues on to a downstairs bedroom and shower room and there is a side door from this hall to a small walled enclosure that opens onto the side of the property and main street beyond.Upstairs, on the first floor the landing has built-in storage with the main bedroom having its own ensuite with bath and overhead shower.Externally, the property has a small rear yard enclosed by old stone walls. This property has to be seen to be appreciated and is within walking distance of everything Dungarvan has to offer."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Town centre location. </li><li>Walking distance to everything Dungarvan has to offer. </li><li>Ground floor bedroom and shower room.</li><li>Side entrance with feature stonework.</li><li>Just off N25 Cork-Waterford route.</li><li>Rear enclosed yard.</li><li>Mains services.</ul>"
      },
