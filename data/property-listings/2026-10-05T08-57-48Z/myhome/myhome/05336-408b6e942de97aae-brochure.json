    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "A compact Art Deco House (c. 1935) conveniently located off Drumcondra Road, easily accessible to both Dublin Airport and the city centre and beside DCU St. Patrick's Campus with good local shopping and in a prime residential area of great amenity. The property retains its original features and presents an exciting refurbishment opportunity."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance Hall, Cloaks Area, Living Room with fireplace 3.80 m.  x  3.55 m., with folding doors to Dining Room 3.70 m.  x  3.20 m., Kitchen 2.60 m.  x  2.40 m., Bedroom 1 _ 3.75 m.  x  3.35 m., Bedroom 2 - 3.80 m.  x  3.30 m., Bedroom 3 - 2.55 m.  x  2.35 m., Bathroom/WHB, Separate WC, Oil Fired Radiator Central Heating Installed. Garden in Front, Large Garden at rear. Garage 5.90 m.  x  4.40 m., Separate pedestrian rear entrance./"
      },
      {
        "ContentType": "Features",
