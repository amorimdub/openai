    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Superb mix residential /Commercial investment opportunity in the Heart of Phibsboro.\r\nProperty is opposite the entrance to the new Dalymont Soccer Stadium and beside the Proposed Phibsboro Shopping \r\nCentre Development.\r\n4/5 bedrooms residential accommodation with good rental income potential\r\nDouble Frontage shop unit with ownership of area to the front for tables\r\nProperty is 5 min walk too Luas Stop and  15 minute walk to TUI GrangeGorman"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Double frontage shop area ground floor with good storage to the rear ownership of area to the front\r\n4/5 bedrooms to the side and first floor level Double rooms\r\nTwo bathrooms\r\nKitchen"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Double Frontage shop with good storage to the rear\r\nOwnership of area to the front for tables\r\n4/5 bedrooms to the side and first floor\r\nGood sized bedrooms"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "Property is at Junction of St Peters Church and North Circular Road\r\nIt is Directly opposite Dalymont Park entrance which will be an all seater stadium"
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Contact Agent Tim Mc Donald 086-2470895 flexible viewing times"
      }
