    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Louis Boyce Estate Agents are delighted to offer this spacious 6-bedroom detached residence within walking distance of ATU & the Town Centre. This property extends to circa 180sq.m., is in excellent decorative condition throughout and occupies a prominent position within the mature and highly regarded Oaklands development. This property offers exceptionally generous and versatile accommodation and can be converted back into a 1-bedroom apartment and 5-bedroom house for rental optimisation."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Notice\nPlease note we have not tested any apparatus, fixtures, fittings, or services. Interested parties must undertake their own investigation into the working order of these items. All measurements are approximate and photographs provided for guidance only."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> Large detached property extending to c.2000 sq.ft. </li><li> Walking distance of ATU & Letterkenny town centre </li><li> Comprising 2 reception rooms,open-plan kitchen/dining area, </li><li> Utility, bathroom with shower and bedroom on ground floor with separate entrance. </li><li> Decking area off sunroom leading to private south facing rear garden </li><li> 5 First floor bedrooms (1 ensuite) and bathroom. </li><li> Attic storage </li><li> Solid fuel stove with back boiler in sitting room </li><li> Walled patio to front </li><li> OFCH</li></ul>"
      },
