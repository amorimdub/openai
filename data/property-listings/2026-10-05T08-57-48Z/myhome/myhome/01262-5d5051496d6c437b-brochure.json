    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "A 2 bedroom semi-detached residence sitauted at 60 Lisnaboley, Claremorris, Co. Mayo. It extends to circa 615 sq.ft. It is situated approximately 1 km from the town centre and all its amenties.\r\nSome of its features include timber flooring in entrance hallway, fully fitted kitchen, fully tiled bathroom, oil fired central heating, white double glazed PVC windows and doors, front garden, large rear garden, concrete driveaway with parking.\r\nThe accomodation comprises of Entrance Hallway, Sitting Room, Kitchen, Utility Room, Guest WC, 2 Bedrooms, 1 Bathroom. Externally there is a garden shed.\r\nThis is an ideal family home or investment opportunity and viewing is highly recommended."
      },
      {
        "ContentType": "Rooms",
        "SortOrder": 2,
        "Content": "Entrance Hallway - 3.23m x 0.965m \r\nTimber Flooring, 1 radiator.\r\n\r\nSitting Room - 3.1m x 2.61m \r\nTimber flooring, solid fuel stove, 1 radiator.\r\n\r\nKitchen - 4.1m x 3.2m \r\nTiled flooring, fitted kitchen, double oven, fridge freezer, 1 radiator. \r\n\r\nUtility Room - 1.7m x 1.1m \r\nTiled flooring, plumbed for washing machine.\r\n\r\nGuest WC - 1.6m x 0.683m \r\nTiled flooring, semi-tiled walls, WC, wash hand basin, 1 radiator.\r\n\r\nUpstairs - \r\n\r\n\r\nBedroom 1 - 3.54m x 2.66m \r\nTimber flooring, 1 radiator.\r\n\r\nBedroom 2 - 3.521m x 2.52m \r\nTimber flooring, 1 radiator.\r\n\r\nBathroom - 2.4m x 1.83m \r\nFully tiled, WC, wash hand basin, bathwith overhead electric shower, 1 radiator.\r\n\r\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "2 bedroom semi-detached residence.\r\nLocated 1km from Claremorris Town Centre.\r\nFully fitted Kitchen.\r\nFully tiled Bathroom.\r\nOil fired central heating.\r\nWhite double glazed PVC windows and doors.\r\nFront Garden.\r\nLarge rear Garden.\r\nConcrete driveway with parking."
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: E"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "From Claremorris, take the castlebar road and drive approximately for 800m. House is on left hand side, directly across from Grattan Park. Look out for the DNG Gilligan sign. F12 H2P5."
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Highly recommended and by appointment only."
      }
