    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "A Fabulous Detached Dormer Bungalow on about 1 Acre on Dublin Side of Navan Town, having 6 bedrooms, 2 Reception Rooms, Electric Gated Entrance, lawns, trees, shrubs in a mature private Gardens, Porch, entrance Hallway, 2 Reception Rooms, an Office, large Fitted Kitchen with an Island, Oil Cooker and a Dining area, fitted Utility Room, family Bathroom on two floors, Master Bedroom with spacious Wardrobes and a Shower Room Ensuite, 3 Bedrooms on first Floor, Detached Double Garage, Sun Terrace, all in fab condition"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance Porch, Hallway, Front Sitting Room with 2 Bay Windows, Family Room with an Open Fireplace and patio doors to a sun terrace, large fitted Kitchen, having an Island unit, Oil Cooker, all electrics, and a nice Dining area, fitted Utility Room, ground floor Family Bathroom fully tiled, Master Bedroom with lots of Wardrobes and a Shoer Room ensuite, two other ground floor Bedrooms and a small Office, first floor has 3 Bedrooms and a Bathroom"
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: C3"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "At Old Bridge Inn on Dublin side of Navan travel towards Cannistown, located on RHS about 1 Kilometre from main Road and Bus Service"
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Its a must, great condition and highly recommended by appointment"
      }
