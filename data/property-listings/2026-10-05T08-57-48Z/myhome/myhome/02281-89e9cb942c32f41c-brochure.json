    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "It’s seldom a property with real potential and the possibility of multiple choices as to future use comes to the market. 1 Irishtown Road fills that brief.\r\nCurrently used as office and investment it has other possibilities."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "The property currently comprises;\r\nBarber Shop on entrance hall level.\r\nArchitects off on first floor\r\nPhotographic studio on garden level.\r\n1ST Floor plan: Commercial: 30.0 sq.m.\r\nGround Floor: COMMERCIAL: 25.0 sq.m.\r\nLobby 2.6 sq.m.\r\nStairs and Landing: 6.0 sq.m.\r\nShared Kitchen: 3.0 sq.m.\r\nBasement CommercialL: 27.0 sq.m.\r\nStairs and landing: 5.6 sq.m.\r\nShared WC: 3.0 sq.m. \r\nTOTAL 102.2 sq.m."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "This is a well located property in the heart of Irishtown and in the heart of an area that is undergoing significant change. The Gas Bottle site just up the road is bringing many opportunities to the area with a significant increase in population.\r\nThis property offers the opportunity for use as an office with a good position and high visibility, an office with investment income as in its current use, a pure investment property or the conversion to a modern stylish home. Its small garden and car space offers the opportunity of outside space as well as a hard to find car space."
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: B1"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "From city its on the right hand side at the junction with Dermot O'Hurley Avenue."
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "By appointment only."
      }
