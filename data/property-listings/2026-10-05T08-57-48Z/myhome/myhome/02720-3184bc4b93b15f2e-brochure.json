    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nSherry FitzGerald McDermott are delighted to present this charming extended semi detached cottage, ideally positioned on an elevated site within walking distance of all town amenities.\nRecently upgraded and presented in turn key condition, this attractive stone faced cottage offers a wonderful opportunity for those seeking a comfortable home with character, convienience and generous outdoor space.\nSet on a generous C. 0.27 acre site the property benefits from ample on site parking . To the rear there is a generously appointed block built detached shed, providing excellent storage and offering a variety of potential uses for the discerning purchaser"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nLounge - 4.202 x 3.453\nPolished Wooden floor.Stone Fireplace.Airing Press.\n\nKitchen / Diner - 4.044 x 3.393+ 2.503x1.958\nFitted Kitchen.Tiled floor.Pine ceiling with recessed lighting & Velux windows\n\nBedroom 1 - 4.126 x 3.096\nCarpeted\n\nShower room - 2.834x1.941\nWalk in Shower.Vanity sink unitMarley Flooring\n\nLanding - 1.674x 0.823\nCarpeted\n\nBedroom 2 - 4.181 x 3.681\nCarpeted.Recessed lights\n\nBedroom 3 - 2.672 x 3.381\nCarpetedRecessed LightingVelux window\n\nDetached Shed - 4.125 x7.353\nBlock Built.W.C. Off\n\n"
      },
