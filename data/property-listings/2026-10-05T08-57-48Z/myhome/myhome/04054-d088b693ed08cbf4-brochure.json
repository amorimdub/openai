    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Fantastic 3 bedroom mid-terrace home situated in the coastal area of Bettystown, Co. Meath. The property extends to c. 98 sq. m (c. 1,054 sq. ft.) offering bright & comfortable living areas, and is in excellent condition throughout. Brabazon is a very sought after location on the Meath Gold Coast and this well cared for development is within walking distance to the local shop, Bettystown Beach, Laytown & Bettystown Golf & Tennis Club. With easy access to Drogheda Town and Dublin City via road and rail, this property would ideally suit a first time buyer or equally, anyone who requires a property that is well presented and ready to walk in to. Viewing is highly recommended."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Hallway \r\nLiving \tRoom\t\t(5.09m x 4.05m)\r\nKitchen / Dining\t(3.11m x 5.16m)\r\nGuest WC\t\t(1.50m x 2.10m)\r\n\r\nLanding\r\nBedroom 1\t\t(4.50m x 2.95m)\r\nEn Suite\t\t(1.60m x 1.50m)\r\nBedroom 2\t\t(2.95m x 3.68m)\r\nBedroom 3\t\t(2.20m x 3.50m)\r\nBathroom\t\t(1.68m x 2.37m)"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "3 Bedroom Mid-Terrace Property\r\nBuilt c. 2003\r\nExtends to c. 98 sq.m (c. 1,054 sq.ft.)\r\nGarden Room / Shomera  - 2020 (2.81m x 3.91m)\r\nG-F-C-H\r\nRemote Controlled Gazco Gas Fire - 2025 \r\nSmart Understairs Storage – 2024\r\nFully Tiled Bathrooms - 2024\r\nIntegrated Kitchen with Quartz Countertops \r\nHardwood Oak Flooring - Living Room \r\nTriple & Double Glazing Throughout - 2020\r\nUpgraded Attic Insulation - 2025\r\nStira Staircase to Attic Storage - 2025\r\nFully Alarmed\r\nPrivate Rear Aspect\r\nSouth Facing Rear Orientation\r\nLandscaped Rear Garden\r\nMature Raised Planter Beds\r\nPaved Patio Area\r\n2 Designated Parking"
      },
