    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Park Galbally County Limerick\r\nAttractive compact bungalow type residence near all amenities and services, short walk Galbally Village in pristine walk in condition without penny  further outlay immaculate."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Front door leads to compact dining area tiled floor, sittingroomwith solid fuel stove with Tiled fireplace with laminated floor, kitchen with breakfast area with modern fitted units electric hob and cooker belfast sink Attractive tiled floor with patio doors to rear Master Bedroom laminated floor with sliding door mirrored wardrobe Bedroom 2  double laminated floor with sliding door mirrored wardrobe"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Approached by Expensive Composite 12ft roller gate with walled in hard-core frontage with Shrubbery\r\nPatio doors to rear with expensive gate entrance again hard-core with slate effect concrete fence with very attractive shrubbery  and high wall at  side affording privacy path around compact steel shed on concrete Base solar lights CCTV installed modern double Glazed windows and doors Scenic views at rear traps the Sun. Oil fired central heating. Outside tap."
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: F"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "Galbally Village E34FF67"
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "By strict appointment with auctioneers"
      }
