    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "ERA Tobin Estate Agents are delighted to offer for sale this two storey derelict stone residence attached lofted outbuilding. The property has the benefit of full planning permission (ref number 2560994) and qualifies for the derelict house grant along with energy upgrade schemes. Ideally situated on an elevated site of circa 0.64 acres just 3km from Kingscourt and circa 8km from Drumconrath, close to all amenities."
      }
