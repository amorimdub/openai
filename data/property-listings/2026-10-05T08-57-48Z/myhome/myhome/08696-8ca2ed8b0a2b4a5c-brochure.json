    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nThis property comprises of a residential site being sold with the benefit of Full Planning Permission and additional agricultural land. \n\nThe entire property is set on an elevated site measuring approximately 5.7 acres with countryside views, situated off the main Westport to Newport Road, in the townland of Ardkeen, Kilmeena.\n\nPlanning Permission has been approved for a substantial detached house with a floor area extending to 195 square meters. \n\nAccommodation is to comprise of entrance hall, living room, kitchen/dining, utility, four bedrooms (one with walk in wardrobe and en-suite) and a family bathroom. \n\nArdkeen is conveniently situated in a picturesque countryside location less than 10 minutes from both Westport and Newport towns via the recently upgraded N59 road. Local amenities include Kilmeena National School and Pre-School, St. Brendan's church and Kilmeena sports club, all within a two minute drive.\n\nWestport's amenities include National train and Bus links, secondary schools, shops, bars/restaurants, and a wide choice of leisure facilities."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Site with Full Planning Permission and Agricultural Land</li><li>Entire property extends to approximately 5.7 acres</li><li>Planning permission for a four bedroom detached residence of 195sqm</li><li>Countryside views</li><li>Short drive to Westport and Newport Towns</li><li>Close to Kilmeena pre-school, School, church and sports club</ul>"
      },
