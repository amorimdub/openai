    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Campbells Auctioneers are delighted to present to the market this parcel of land located in the peaceful rural area of Crickamore, just a short drive from Dungloe town.\n\nThe property comprises five separate plots of land clustered closely together, extending to a combined area of approximately 1.7 acres. Please note that this area is an approximate measurement.\n\nAn attractive feature of the property is the presence of an old stone ruin, adding character to the site and offering an interesting feature for prospective purchasers.\n\nSituated in a quiet rural setting, the lands are conveniently positioned within easy reach of Dungloe and the many villages, beaches and amenities throughout the surrounding Rosses area.\n\nThe property may appeal to those seeking a small holding of land in the locality or purchasers interested in a site containing an existing traditional ruin.\n\nOur Ref: K1297\n"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Notice\nPlease note we have not tested any apparatus, fixtures, fittings, or services. Interested parties must undertake their own investigation into the working order of these items. All measurements are approximate and photographs provided for guidance only."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> Combined area of approximately 1.7 acres </li><li> Old stone ruin located on the property </li><li> Convenient to Dungloe town</li></ul>"
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Kenneth Campbell"
      }
