    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "This impressive 4-bedroom, 3-bathroom home at Tipperstown Walk blends timeless architecture with modern practicality. Elegant red brick facades with limestone surrounds frame interiors that feature a generous open-plan kitchen, living, and dining space, alongside a separate living room for added flexibility. Well-proportioned rooms, quality finishes, and abundant natural light create a harmonious flow, while the surrounding tree-lined avenues and landscaped green spaces deliver a true sense of place."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Special Features\r\n•\tDirectly across from Naas Racecourse\r\n•\tMoments from M7 access and Naas & Sallins station\r\n•\tShort drive to Kildare Village and Punchestown\r\n•\tOn the doorstep of scenic countryside, walks, and lakes\r\n•\tTipper Road is renowned locally and beyond for its prestige, charm, and convenience — offering the ideal address for both trading-up buyers and discerning first-time purchasers seeking a long-term home.\r\n•\tThis is not just another new development — it’s a premium address, with a product to match."
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: A2"
      }
