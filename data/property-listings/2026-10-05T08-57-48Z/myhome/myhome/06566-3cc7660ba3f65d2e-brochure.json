    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nA rare opportunity to acquire a substantial site extending to approximately 2.3 acres, held under Folio KK16846F, in an exceptionally convenient location just five minutes' drive from Kilkenny City Centre.\n\nThe property enjoys a private rural setting while remaining close to neighbouring residential properties and within easy reach of the city's extensive amenities, schools and transport links. Offering an excellent balance of countryside living and city convenience, this is a particularly attractive and seldom available opportunity in a highly sought-after location.\n\nThe generous site area provides considerable potential for purchasers seeking to create a distinctive family home in a peaceful setting, subject to obtaining the necessary planning permission and satisfying all relevant planning criteria.\n\nFurther particulars and maps are available upon request."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> - Large c. 2.3 acre site offering potential for both residential dwelling and paddock/sand arena.</li><li> - Very attractive location (just 5 mins drive to Kilkenny City Centre)</li><li> - Can be purchased subject to FPP but Kilkenny COCO Local needs rule will apply.</ul>"
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Ciaran Dunphy"
      }
