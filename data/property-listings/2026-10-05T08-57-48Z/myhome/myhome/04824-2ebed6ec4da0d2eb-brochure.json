    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "215 Barton Road East presents an outstanding opportunity to acquire a four bedroom semi-detached property with exceptional potential, ideally positioned in one of Dundrum’s most sought after locations, literally overlooking The Dundrum Town Centre. \r\nThe house is in need of refurbishment, offering the creative purchaser a blank canvas to create a stylish, modern family home tailored to their own taste and personal requirements.\r\n\r\nThe house sits on a site with excellent road frontage and enjoys an enviable, elevated position beside Dundrum Town Centre and within walking distance of (within ten mins walk) Balally LUAS, Ballawley Park, Airfield Gardens and a host of schools and Colleges including Wesley College, Mount Anville Convent, Goatstown Educate together, Holy Cross school, Taney Parish primary school and many more."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "There is good parking to the front and spacious side entrance to the rear garden, which has substantial road frontage on to Ballinteer Road.\r\nInternally there is a hallway, downstairs cloakroom (wc & whb), 3 / 4 reception rooms (one of these has a temporary stud partition), 4 bedrooms (2 double, 2 single) and a bathroom."
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: E2"
      }
