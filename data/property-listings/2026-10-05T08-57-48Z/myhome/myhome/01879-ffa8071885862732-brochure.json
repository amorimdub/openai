    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nAn excellent opportunity to acquire a well-proportioned three-bedroom detached bungalow, ideally suited to first-time buyers, downsizers or those looking for a comfortable home within easy reach of the town centre.\n\nThe property occupies a generous site with a tarmacadam driveway providing ample off-street parking, enclosed by a wall boundary. The mature front garden provides an attractive approach to the property, while the rear grounds are designed with ease of maintenance in mind.\n\nThis property may be eligible for the Vacant Property Refurbishment Grant, subject to the relevant qualifying criteria, which could provide a significant opportunity for the successful purchaser to transform the property into their ideal home.\n\nA viewing comes highly recommended and by appointment only with sole selling agents Sherry FitzGerald O Donovan."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - 6.00m x 2.13m\nTiled flooring. Cornicing to ceiling.\n\nSitting Room - 4.28m x 3.59m\nCarpet. Solid Fuel Fire with feature stone surround. Cornicing to ceiling.\n\nKitchen - 4.13m x 3.97m\nTiled flooring, Fully fitted kitchen with integrated hob and double oven, door to rear.\n\nBedroom 1 - 4.13m x 3.22m\nCarpet, Fitted Robes\n\nBedroom 2 - 4.28m x 2.40m\nCarpet, Fitted Robes\n\nBedroom 3 - 2.61m x 2.89m\nCarpet\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>OFCH</li><li>Ample off-street parking</li><li>Tarmacadam driveway</li><li>Convenient location close to the town centre</li><li>Potential eligibility for the Vacant Property Refurbishment Grant, subject to the relevant criteria</li><li>Ideal for first-time buyers and downsizers</ul>"
      },
