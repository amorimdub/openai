    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Superbly presented 2 bed townhouse with front and rear gardens. In excellent condition throughout the property features a large new deck and has a south west facing garden with rear access. Coveniently located just off Skibbereen town centre in an established residential area.\r\nServices: Oil fired central heating, mains services, fibre broadband"
      },
      {
        "ContentType": "Rooms",
        "SortOrder": 2,
        "Content": "Entrance Hall - 2.0m x 1.8m \r\nOak floor, wooden staircase\r\n\r\nSitting Room - 4.5m x 3.0m \r\nOak floor, solid fuel stove with tiled surround, garden views\r\n\r\nKitchen/Dining Room - 4.5m x 3.0m \r\nOak floor, half panel wall, modern oak kitchen with tiled worktop, gas hob, electric oven, fridge, freezer, washing machine, under stairs storage, glass door to west facing deck\r\n\r\nLanding - 2.2m x 1.2m \r\nGarden views\r\n\r\nBedroom 1 - 4.5m x 2.5m \r\nWooden floor, cast iron fireplace\r\n\r\nBedroom 2 - 3.4m x 3.2m \r\nWooden floor, cast iron fireplace, closet, garden views\r\n\r\nBathroom - 2.5m x 1.4m \r\nCork floor, tiled walls, bath, wash hand basin, w.c.\r\n\r\n"
      },
