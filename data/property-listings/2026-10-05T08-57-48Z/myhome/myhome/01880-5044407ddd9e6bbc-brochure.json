    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "A well-presented four-bedroom dormer bungalow offering spacious and versatile accommodation over two floors.\r\n\r\nThe property comprises an entrance hallway, living room with open fireplace, kitchen/dining area, separate utility room, two ground-floor bedrooms and a bathroom.\r\n\r\nThe first floor provides a further two bedrooms and a second bathroom.\r\n\r\nThe property also benefits from oil-fired central heating, off-street parking and private rear garden."
      },
