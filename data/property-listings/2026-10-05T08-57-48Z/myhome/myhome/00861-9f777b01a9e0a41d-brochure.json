    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Gordon Hughes Estate Agents are pleased to present this charming 3 bedroom cottage for rent. Situated on approximately 0.34 acres, the property enjoys scenic views of the surrounding countryside whilst being located less than a 5-minute drive (4.8 km) from the thriving village of Leitrim. Accommodation comprises a hallway, living room (with stove), kitchen, bathroom and 3 bedrooms. Features include a generous garden area, peaceful rural setting and convenient access to all services and amenities. Viewing Strictly by Appointment Only with Sole Agent."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance Hallway\r\nLiving Room (Solid Fuel Stove)\r\nKitchen\r\nBathroom\r\n3 Bedrooms"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Charming 3 Bedroom Cottage\r\nSituated on Approx. 0.34 Acres\r\nScenic Countryside Views\r\nPeaceful Rural Setting\r\nSpacious Garden Area\r\nLiving Room with Solid Fuel Stove\r\nBright & Well-Proportioned Accommodation\r\nLess Than 5 Minutes from Leitrim Village\r\nConvenient Access to Local Amenities\r\nReady for Immediate Occupation"
      },
