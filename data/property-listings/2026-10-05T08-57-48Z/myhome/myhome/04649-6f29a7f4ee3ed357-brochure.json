    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "This well appointed 6 bedroomed family home on a 0.50 acre site is ideally situated in a rural setting, yet a mere 3 minute drive from Mercy Mounthawk Secondary School, 10 minutes from Fenit Village/Marina and just 12 minutes from Banna Beach.  You are also within a 5 minute drive of Tralee Town Centre.\r\nOutside is a large garage, gated driveway and well laid out gardens with excellent privacy"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance hallway\r\nLiving Room \r\nKitchen/Diner\r\nUtility \r\nW.C.\r\nBedroom 1\r\nFamily Room \r\n1st Floor \r\nBedroom 2\r\nMain Bathroom \r\nBedroom 3\r\nBedroom 4\r\nLanding Area\r\nBedroom 5\r\nBedroom 6\r\nOutside\r\nLarge Patio Area\r\nDetached Garage"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Block built in 1998\r\nSlate Roof \r\nPVC Double Glazed Windows\r\nPrivate Entrance Road with ROW\r\nMains Water, Electricity and Septic Tank"
      }
