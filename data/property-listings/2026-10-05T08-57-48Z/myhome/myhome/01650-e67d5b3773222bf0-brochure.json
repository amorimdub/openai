    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nNo. 5 Cois Croinn is a two bedroomed ground floor apartment in a central location convenient to shops, churches, primary and secondary schools. The M1 Motorway is located nearby, allowing for an easy commute to Dublin and Belfast.\n\nAccommodation of this modern apartment includes entrance hall, open plan sitting room/kitchen/diner, two bedrooms and bathroom.\n\nThis apartment which has been well cared for and is an ideal investment to a savvy investor or of course the keen First Time Buyer. A well proportioned, enclosed rear garden completes the picture. \n\nViewing of this fine property is highly recommended!"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nGROUND FLOOR - \n\n\nEntrance Hall - \n\n\nKitchen Dining Room - 5.01m x 5.00m\n\n\nBathroom - 2.00m x 1.90m\n\n\nMaster Bedroom - 3.30m x 3.00m\n\n\nBedroom 1 - 3.30m x 1.90m\n\n\n"
