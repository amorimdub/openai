    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nBarry Walsh Associates are proud to bring to the market for sale 11 Woodlands Heights a stunning ready to walk into exquisite 3 bed family home in mint conditionNestled in a well-established sought after location of Carrick-Beg, Carrick-On-Suir, this charming detached bungalow offers a rare opportunity to purchase a property in this sought after area with convenient access to all amenities. This property combines generous living space, exceptional privacy, and a prime location that will appeal to a wide range of buyers.The well-maintained garden provides a serene outdoor space, perfect for relaxing or entertaining guests. With private parking and a detached garage, there is ample space for vehicles and storage. Don't miss the opportunity to make this delightful property your new home. Contact us today to arrange a viewing."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nHall - 1.07m x 8.90m\n\n\nLiving Room - 3.98m x 3.30m\n\n\nSitting Room/Study - 3.98m x 3.30m\n\n\nKitchen/Breakfast Room - 3.98m x 4.92m\n\n\nBedroom 1 - 3.18m x 3.30m\n\n\nBedroom 2 - 3.17m x 2.74m\n\n\nBathroom/Shower Room - 3.15m x 1.97m\n\n\nBedroom 3 - 3.47m x 3.91m\n\n\nEXTERNAL - \n\n\nStore/Garage/Utility - 3.40m x 6.60m\n\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Town centre bungalow residence</li><li>Presented in mint condition</li><li>Stunning landscaped rear garden</li><li>Sought after location</li><li>Garden to the front and rear</li><li>External Insulation on property</li><li>Oil Fired Central Heating</li><li>C2 BER </li><li>External Garage</li><li>5 minutes walk from Main Street and all amenities</ul>"
      },
