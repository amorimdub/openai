    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nA charming three-bedroom bungalow residence, ideally positioned in a quiet and established enclave within easy walking distance of the town centre. The property offers well-proportioned and thoughtfully laid-out living and bedroom accommodation, providing a comfortable and versatile home for prospective purchasers.\n\nExternally, the property benefits from a private, enclosed rear garden, providing an attractive and secluded outdoor space with excellent potential for relaxation and entertaining.\n\nSituated in a highly sought-after and convenient location, this delightful home is sure to appeal to a wide range of purchasers and will undoubtedly commend itself to those seeking a comfortable residence within easy reach of the town and its many amenities."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - \ncarpet floor covering.\n\nLiving Room - 7.48m x 5.04m\nwith carpet floor covering.\n\nKitchen - 3.96m x 3.52m\nwith pine kitchen, lino floor covering.\n\nUtility Room - 2.50m x 1.66m\nplumbed for washing machine, lino floor covering.\n\nBathroom - 2.95m x 2.27m\nwith bath, w.c, hand basin, lino floor covering.\n\nBedroom One - 3.67m x 3.22m\nwith carpet floor covering, built in wardrobe.\n\nBedroom Two - 3.67m x 3.34m\nwith carpet floor covering, built in wardrobe.\n\nBedroom Three - 4.28m x 3.54m\nwith carpet floor covering, built in wardrobe.\n\nGarage - 8.43m x 2.65m\n\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Mains water & sewerage, oil fired central heating</ul>"
      },
