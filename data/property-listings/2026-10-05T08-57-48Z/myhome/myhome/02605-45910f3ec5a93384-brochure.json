    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nNew to the market this spacious 4 bedroom, 2 bathroom, Duplex unit at Wellmount Student Village, the property offers a superb investment opportunity and is being sold with vacant possession. The property is centrally located in close proximity to Technological University of the Shannon-TUS and Athlone Town Centre. \n\nThe property offers the following accommodation: Entrance Hall, Living Room, Kitchen/Dining room with access to balcony, two bedrooms and a bathroom, upstairs there are an additional two bedrooms and a further bathroom."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nGround Floor - \n\n\nHall - 6 x 1.8\n\n\nBedroom 1 - 3 x 2.65m\nCarpet, Wardrobe\n\nBedroom 2 - 3.3 x 2.7\n\n\nBathroom - 1.7 x 2.38\nTiled, w.c, wtb, shower\n\nLiving Room - 3 x 2.99\nCarpet\n\nKitchen Dining Room - 4.62m x 4.78m\nFitted with large window, access to balcony\n\nBalcony - 4.1 x 1.1\n\n\nUpstairs: 2 Bedroom & Bathroom - 7.98m x 6.26m\n\n\nBedroom 3 - 3 x 6\nCarpet, wardrobe, Study desk & Velux\n\nBedroom 4 - 3 x 6.1\nCarpet, wardrobe, Study Desk & Velux\n\nBathroom - 1.98m x 2.53m\nw.c, wtb, shower, tiled\n\n"
      },
