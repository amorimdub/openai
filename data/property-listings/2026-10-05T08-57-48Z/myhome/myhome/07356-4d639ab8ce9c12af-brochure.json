    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nREA Seamus Carthy present to the Market a quality c. 30 acre Land Holding. Considered an excellent opportunity to acquire a high-quality agricultural holding extending to approximately 30 acres, complete with a functional hayshed. Set in the highly accessible townland of Cloonboniffe, County Roscommon, this versatile property is conveniently located close to Castlerea, Ballyhaunis, and Ballaghaderreen, making it a prime option for local and expanding farmers alike. The property is offered for sale by private treaty, with offers invited for the entire holding or in three distinct Lots. Lot 1 comprises approximately 12 acres contained within Folios RN8087, RN15292F, and RN34113. This is a premium parcel of excellent quality grassland benefiting from extensive road frontage. Directly adjoining this is Lot 2, contained within Folio RN28311, which offers approximately 8 acres of fine, productive ground laid out in grass. Finally, Lot 3 is encompassed in Folios RN8123 and RN27748, offering approximately 10 acres of grassland featuring excellent road frontage and a substantial hayshed. Offers now invited for immediate sale.\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Accessible Location\nFlexible Lot Sizes\nGood quality Grassland\nOffers neighbouring farmers opportunity to expand\nManageable Lots\nOffers Invited for individual Lots\nRN28311 - 3.27 hec/ 8 acres\nRN34113 - 2.22 hec / 5.48 acres\nRN15292F - 1.16 hec / 2.86 acres\nRN8087 - 1.40 hec / 3.45 acres\nRN27748F - part of - c.3 acres\nRN8123 - part of - c.7 acres \n Main Services Available."
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "Travel towards the village of Cloonbonniffe, leaving cloonbonniffe school on your left , eircode F45FX92, the subject lands are located on your left hand side c. 300 m. Please note REA Seamus Carthy for Sale Boards."
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Seamus Carthy"
      }
    ],
