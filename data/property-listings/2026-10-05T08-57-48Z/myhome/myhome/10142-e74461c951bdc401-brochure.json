    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Louis Boyce Estate Agents are pleased to offer this derelict house for sale in Tully Mt. Ramelton. This property comprises circa 0.3 acres in a quiet rural location close to Letterkenny, Milford, and Ramelton. \n`There are existing construction drawings in place and planning permission has been approved for the new build. The house also has previous vacant property Grant approval of 70k.`\nThere has been approval of a new septic tank, demolition of the old extension, and moving the driveway for safer entry and exiting of the property."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Notice\nPlease note we have not tested any apparatus, fixtures, fittings, or services. Interested parties must undertake their own investigation into the working order of these items. All measurements are approximate and photographs provided for guidance only."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> Derelict house for sale </li><li> Popular rural location </li><li> 0.3 acre site </li><li> Close to Letterkenny, Milford, and Ramelton </li><li> Ideal renovation project</li></ul>"
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: G<br>BER No: 117728261<br>Energy Performance Indicator: 828.44 kWh/m2/yr"
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Louis Boyce"
      }
