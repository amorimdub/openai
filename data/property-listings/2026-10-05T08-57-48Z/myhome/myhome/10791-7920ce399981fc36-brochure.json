    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Spacious detached Bungalow located in a prime residential area of Bandon town . This detached bungalow is with in walking distance to Bandon town shops and services. The property  requires some modernisation . The property has Oil heating and insulated slab on external walls .The bungalow has its own drive way and front and rear garden with storage areas to the rear."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "The accommodation comprises of Entrance door to Hallway to living room , Kitchen, 3 bedrooms , shower room , Outside there is storage areas and own drive way with parking , and gardens to front and rear .\r\nThe property has oil heating throughout , mains drains and mains water , with fibre broadband available ."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "The bungalow  is on a level walk to the town with easy access to too shops and services. Bandon town is a thriving town with many shops and places of worship near by. \r\nBandon town is a historical town dating back to the early 1600s, many of the historical landmarks are still existing throughout the town.\r\nCork city and Airport are within a 20 minutes drive ."
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: G"
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Joint Agents with Paddy Murray Auctioneers Bandon ."
      }
    ],
