    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Fantastic bright spacious Dormer Bungalow\n4 Bedrooms (2 ensuite) with Large Garage\nIn Show House Condition throughout on circa 1 acre site with beautiful mature trees and shrubs"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Spacious Hallway: 20'01\" x 11'05\"\n\nKitchen/Diner: 14'06\" x 14'30\" c/w Tiled floor, solid wood kitchen units with built in oven and hob, \nsolid fuel stove with feature fire surround, bay window\n\nSitting room: 14'6\" x 13'0\" c/w Carpet, feature cast iron fireplace with multi fuel stove\n\nUtility: 9'08\" x 6'9\" c/w Tiled floor, fitted units\n\nGuest Bedroom: 14'8\" x 10'8\" c/w Wooden floor, bay window\nEn suite: Fully tiled\n\nBedroom 2: 12'8\" x 11'8\" c/w Wooden floor\n\nUpstairs\nLanding Corridor: 16'8\" x7.9 c/w Wooden stairs & floor\n\nMaster Bedroom: 14'8\" x 12.6\" c/w Wooden floor\nEnsuite: Tiled walls and floor\n\nBedroom 4: 14'8\" x 12'6\" c/w Wooden floor\n\nBathroom: 9'8\" x 7'5\" c/w Tiled floor and walls\n\nDetached Garage: 17' x'15' with loft"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Pvc Double glazed windows and doors\nPvc Fascia, soffit and gutters\n2 Bedrooms ensuite\nMulti fuel stoves in sitting room and living room\nCorniced and coved ceilings\nMoulded skirting and architrave\nLarge garage with loft\nFantastic secluded garden with mature trees and shrubs\nGarden lighting, ornate rockery, fruit trees"
      },
