    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nSeeking offers over 179,000\n\nCarrigeen Street is a great town location - an easy walk to local amenities such as schools and supermarkets, but also is a short stroll to Wexford's Town Centre with all the attractions and conveniences on offer.\nThis is an attractive mid-terraced 62 sqm home built around 1910 and offers living/dining room with stove, leading into the kitchen to the rear, lobby and shower room. Upstairs are two good -sized bedrooms.\nElectric heating, small raised patio section to the rear, 62 sqm, 2 bedrooms, 1 shower room. Residents can apply for on-street parking permit from Wexford Co. Co."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - 3m x 0.9m\nwith linoleum flooring and storage to the rear\n\nLiving/Dining Room - 6.3m x 2.8m\nwith pine flooring, stove in brick surround, storage in corner unit, staircase to bedrooms\n\nKitchen - 3.3m x 2.4m\nwith linoleum flooring, waist and eye level units, skylight\n\nRear Lobby - 1.2m x 0.9m\nwith linoleum flooring and half glazed door\n\nShower Room - 1.9m x 1.9m\nwith tiled floor and shower surround, WC, WHB and electric shower\n\nLanding - 0.9m x 0.9m\nwith laminate flooring\n\nBedroom 1 - 3.8m x 2.9m\nwith laminate flooring, deep set front facing window, original door, built in shelving\n\nBedroom 2 - 3.1m x 2.9m\nwith laminate flooring and window onto flat roof\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>62 sqm terraced home</li><li>Perfect location for local amenities</li><li>A short walk to Wexford Town</li><li>Large living/dining area</li><li>Kitchen and shower room to the rear</li><li>2 bedrooms upstairs</li><li>Electric heating and stove</ul>"
      },
