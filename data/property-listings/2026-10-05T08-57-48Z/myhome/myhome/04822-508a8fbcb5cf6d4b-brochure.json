    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nBaker Hall is a popular A rated 3 Bedroom semi-detached residential development in Navan town, This beautifully presented property is coming to the market for the first time since it was newly built, offering a rare opportunity to purchase in this popular estate. This home offers stylish, turnkey living in a peaceful setting. Tastefully decorated throughout, the property features a cobble lock driveway with ample parking to the front, and a generous, sun-drenched rear garden—ideal for outdoor enjoyment. All of Navan's amenities are just a short walk away, ensuring convenience as well as comfort. Baker Hall is only a couple of minutes drive away from the M3 with great location for other transport links. Early viewing is highly recommended to avoid disappointment."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - \n\n\nSitting Room - 4.38 x 3.78m\n\n\nKitchen/Dining - 5.78 x 4.44m\n\n\nUtility - 1.81 x 1.53m\n\n\nWC - 1.65 x 1.53m\n\n\nBedroom 1 - 4.70 x 3.26m\n\n\nEn-Suite - 1.81 x 1.76m\n\n\nBedroom 2 - 3.90 x 3.53m\n\n\nBedroom 3 - 2.95 x 2.41m\n\n\nBathroom - 2.55 x 1.71m\n\n\n"
      },
