    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Campbells Auctioneers are delighted to present this attractive site located at Altnagapple, Killybegs, Co. Donegal, extending to approximately 1.08 Acres, to the Open Market.\n\nBeing offered Subject to Planning Permission (STPP), this site presents an excellent opportunity for those wishing to build a home in a peaceful rural setting.\n\nOccupying a convenient location between the vibrant fishing town of Killybegs and the Heritage Town of Ardara, the property enjoys easy access to an excellent range of local amenities including Shops, Schools, Supermarkets, Cafés, Restaurants and Healthcare Facilities.\n\nExtending to approximately 1.08 Acres, the site benefits from ample road frontage and offers generous space for the construction of a substantial dwelling together with extensive gardens, subject to the necessary planning approvals.\n\nViewing is by STRICT Appointment Only with Campbells Auctioneers.\n\nOur Ref: K1275\n"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Notice\nPlease note we have not tested any apparatus, fixtures, fittings, or services. Interested parties must undertake their own investigation into the working order of these items. All measurements are approximate and photographs provided for guidance only."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> 1.08 Acres Approx. </li><li> Ample Road Frontage </li><li> Short Drive to Local Amenities</li></ul>"
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Kenneth Campbell"
      }
    ],
