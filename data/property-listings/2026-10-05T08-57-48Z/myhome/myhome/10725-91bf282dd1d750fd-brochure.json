    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Harry Brann Auctioneers offer you the opportunity to acquire this circa 1.55 hectare / 3.83 acre elevated site boasting panoramic views of The Clare Hills & seasonal views of The lower River Shannon & located within 1.8kms of the popular lakeside twin towns of Ballina/Killaloe. Set in tranquil surroundings on a quiet rural country road, the site offers a party satisfying the \"Local Needs\" planning criteria the ideal opportunity to build their own design on a large private site in this most sought-after location - The site is being sold subject to grant of full planning permission from Tipperary Co Council - PLEASE NOTE THAT \"LOCAL NEEDS POLICY\" APPLIES TO THE PROPERTY."
      },
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Harry Brann Auctioneers offer you the opportunity to acquire this circa 1.55 hectare / 3.83 acre elevated site boasting panoramic views of The Clare Hills & seasonal views of The lower River Shannon & located within 1.8kms of the popular lakeside twin towns of Ballina/Killaloe. Set in tranquil surroundings on a quiet rural country road, the site offers a party satisfying the \"Local Needs\" planning criteria the ideal opportunity to build their own ..."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "\"LOCAL NEEDS\" PLANNING POLICY APPLIES.\r\nFor Sale Subject to grant of Full Planning Permission from Tipperary Co Council.\r\nContained in Folio TY23208F - 1.55 Hectares / 3.83 Acres"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "\"LOCAL NEEDS\" PLANNING POLICY APPLIES.\r\nFor Sale Subject to grant of Full Planning Permission from Tipperary Co Council.\r\nContained in Folio TY23208F - 1.55 Hectares / 3.83 Acres"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "From McKeogh's Hardware Store ( V94YE13) in Ballina, take the R494 Portroe Road. Take the first right up by Ballina National School and travel up the Grange Road around the sharp left bend. Take the next immediate turn to the right, followed by the next turn to the right. Site is only 250mts up on the left, just beyond Eircode V94CKT2 - See Harry Brann \"For Sale\" sign."
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Contact - Negotiator John Phelan on 061-376380 & 086-8181583"
      }
