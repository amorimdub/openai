    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Brophy Estates are delighted to bring to the market 38 Huntstown Rise. This bright and spacious three bedroom house is ideally located in this mature and sought after area. This home benefits from excellent access to a wide range of local amenities. The nearby villages of Mulhuddart and Blanchardstown offer an array of shops, cafes and everyday services. Blanchardstown Shopping Centre is a short distance away, providing retail, dining and leisure options. There are several schools close by, including Blakestown Community School. The National Aquatic Centre is also conveniently located nearby. Excellent transport links with frequent bus services provide direct access to Dublin City Centre, while theM50 and M3 motorways are easily accessible. Both Blanchardstown and Castleknock train stations are within easy reach. 38 Huntstown Rise extends to approximately 88 sq. mt of bright, well proportioned accommodation. The ground floor comprises a separate Living Room, Dining Room and Kitchen. Upstairs there are 3 generous sized bedrooms and a main bathroom."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Accommodation : \r\n\r\nPorch : 1.70m x 0.49m \r\n\r\nHallway : 1.70m x 3.09m \r\n\r\nLiving Room : 3.35m x 4.51m \r\n\r\nDining Room : 5.16m x 3.81m \r\n\r\nKitchen : 2.24m x 4.66m \r\n\r\nBedroom 1 : 3.10m x 4.17m \r\n\r\nBedroom 2 : 3.10m x 3.32m \r\n\r\nBedroom 3 : 1.96m x 2.43m \r\n\r\nBathroom : 1.96m x 2.00m"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Mature residential area\r\n\r\nEasy access to M3 & M50 \r\n\r\nExcellent catchment area for schools \r\n\r\nOff street parking \r\n\r\nPrivate rear garden, not overlooked \r\n\r\nBright, well proportioned rooms"
      },
