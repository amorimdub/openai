    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\n0.52 Acre Site with Full Planning Permission Excellent Location\n\nA superb opportunity to acquire a 0.52-acre site with the benefit of Full Planning Permission, ideally located in a peaceful countryside setting just 5km from Pallasgreen and approximately 20km from Limerick City.\n\nProperty was previously granted planning under REF 2460672\n\nThis attractive site offers the perfect opportunity to build your dream home while enjoying the tranquillity of rural living with excellent connectivity to nearby towns and amenities.\n\nKey Features:\n\n0.52-acre site.\nFull Planning Permission in place.\nQuiet rural location with scenic surroundings.\nJust 5km from Pallasgreen village.\nApproximately 20km from Limerick City.\nEasy access to local schools, shops, sporting facilities, and transport links.\nAn ideal opportunity for owner-occupiers or those seeking a ready-to-build site."
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Liam O'Grady"
      }
