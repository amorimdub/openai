    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Superb 6 Bedroom Dormer Bungalow in pristine condition close to Kilmessan village in the heart of the Boyne Valley. \nNear the Historic Hill of Tara and 5 minutes drive to Royal Tara Golf Club. \nIdeal commuter home for anyone working in Dublin.\nMust be viewed to be appreciate the character and many outstanding features of this home situated in this natural beauty spot."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Hall: c/w Coving, wooden flooring\n\nSitting Room: 19' x 17' c/w Coving, wooden flooring, feature fireplace with wrought iron insert & polished hearth\n\nKitchen/Dining: 20' x 16' c/w Tiled floor, tiled between units, island unit, down lights, patio door to garden\n\nSunroom: 12' x10' c/w Wooden flooring, patio doors to garden\n\nLanding: c/w Carpet flooring\n\nBedroom 1: 11' x 18' c/w Wooden flooring\n\nBedroom 2: 16' x 10' c/w Carpet flooring\n\nBedroom 3: c/w Carpet flooring\n\nBedroom 4: 18' x 12' c/w Carpet flooring, fitted wardrobes\n\nBedroom 5: 12' x 8' c/w Carpet flooring, fitted wardrobes\n\nEn-Suite: c/w Tiled floor, electric shower\n\nBedroom 6: 13' x 11' c/w Carpet flooring, Fitted wardrobes\n\nEn-Suite: c/w Tiled floor, electric shower\n\nBathroom: 9' x 13' c/w Tiled floor, tiled walls, corner bath"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Turn-key condition throughout \n6 Bed 3 Bath\nAlarm\nRear garden\nPVC Double glazed windows \nPVC Facia & soffit\nMaintenance free stone & brick exterior\nOil fired central heating \nDublin airport 30 minutes / Dublin city 30 minutes\nBlanchardstown shopping centre 20 minutes / Dunboyne train station 20 minutes\nIdeal commuter home for anyone working in Dublin"
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Strictly by appointment"
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
