    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\n39B The Bottleworks is a superb third floor apartment ideally located in a secure and popular development on Dermot O'Hurley Avenue off Irishtown Road. Of particular note is the natural light in this apartment, it is presented in excellent decorative order throughout and is stylish and practically laid out. It is further enhanced with a conveniently designated underground car parking space.The property offers exceptionally well-proportioned and stylish accommodation throughout. In brief the accommodation comprises of an entrance hall with storage cupboard/hot press, open plan living/dining room, a modern stylish kitchen, large bedroom and shower room. There is a sunny balcony off the bright and spacious living area.The property is ideally located within walking distance of the City Centre and local villages such as Ballsbridge, Sandymount and Ringsend. Excellent amenities in the area include the Aviva Stadium, SportsCo Leisure Centre and the superb 3 Arena, not to mention Bath Avenue, host to the popular Bath Pub, Lotts & Co Grocers and Slattery's to name but a few. The property also benefits from close proximity to Grand Canal Dart Station with local employers including Google, Facebook, and some of the city's leading law firms."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nEntrance Hall - \nwith storage cupboard/hot press.\n\nLiving/Dining Room - \nwith intercom, tv/phone points, door to balcony and open plan to kitchen.\n\nKitchen - \nwith a range of modern floor and wall units, integrated Siemens fridge/freezer, integrated PowerPoint dishwasher, integrated Siemens electric oven and hob, Elica extractor fan, integrated Indesit washer/dryer and stainless steel sink.\n\nBedroom - \ndouble bedroom with fitted wardrobes and window to internal courtyard.\n\nShower Room - \nwith tiled flooring and partly tiled walls, shower, w.c. wash hand basin, wall mounted mirror and extractor fan.\n\nExterior - \nsunny South-West facing balcony accessed via the living room with views over the communal gardens.\n\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li>Third floor apartment</li><li>South-West facing balcony</li><li>Designated underground parking</li><li>Presented in excellent condition</ul>"
      },
