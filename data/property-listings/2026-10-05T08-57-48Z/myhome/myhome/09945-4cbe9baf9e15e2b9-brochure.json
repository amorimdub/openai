    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Discover a new collection of stylish homes in a well-connected South Dublin setting, offering the ideal balance of modern convenience and outdoor living.\r\nThese contemporary new homes are designed with comfort, efficiency and everyday living in mind, making White Pines Central an ideal choice for first-time buyers, families and downsizers alike"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Bespoke custom built kitchens with stunning Carrera quartz worktops with matching upstands.\r\nBeautifully appointed bathrooms and ensuites.\r\nA rated energy efficient homes.\r\nPrivate south facing gardens in most homes.\r\nprivate designated parking"
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: A2"
      },
      {
        "ContentType": "Directions",
        "SortOrder": 5,
        "Content": "Located close to Rathfarnham Village, the Dublin Mountains, Marlay Park and a wide range of schools, cafés, sports clubs and shopping facilities, White Pines Central is perfectly positioned for modern family living. Residents will also benefit from excellent transport links with easy access to the city centre and M50."
      }
    ],
