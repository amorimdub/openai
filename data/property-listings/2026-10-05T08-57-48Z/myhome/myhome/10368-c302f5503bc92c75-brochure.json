    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "\nInterested in this property? Sign up for mySherryFitz to arrange your viewing, see current offers or make your own offer. Register now at SherryFitz.ie.\n\nEnjoying a peaceful rural location and situated just c.6km from Portumna town, this cottage style residence, whilst requiring refurbishment, has a character and charm that will definitely appeal to the discerning purchaser.This property may also be suitable for the vacant property refurbishment grant.Contact selling agent to arrange viewing appointment."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "\nLiving Room - 3.87m x 4.68m\nFront aspect window, rear aspect window, concrete floor, fireplace\n\nBedroom 1 - 2.22m x 3.34m\nRear aspect window\n\nBedroom 2 - 2.28m x 3.33m\nFront aspect window\n\nBedroom 3 or Dining Room - 2.86m x 3.11m\nFront aspect window, fireplace\n\nBedroom 4 - 1.73m x 3.28m\nRear aspect window\n\nBox Room off Kitchen - 1.65m x 2.03m\nSide aspect window\n\nKitchen - 2.61m x 2.84m\nRear aspect window, door to rear, fireplace\n\nUtility Room - 2.33m x 2.61m\nSide aspect windows\n\n"
      },
      {
