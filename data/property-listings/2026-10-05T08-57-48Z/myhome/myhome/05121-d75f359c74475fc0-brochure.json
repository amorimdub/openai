    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "REA Brophy Farrell are pleased  to bring you 22 Pacelli Road, a three bedroomed end of terrace home set in a mature estate in the heart of Naas town and close to the bank of the Grand Canal. Perfectly located within a short walk of Naas town centre, primary and secondary schools, creches, shops, leisure centre, library, playground and a number of restaurants and bars. It is a short drive to the M7 and the Arrow trains station in Sallins and the bus service to Dublin is just a five minute walk away"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Entrance Hall                  2.04m x 1.66m"
      },
      {
        "ContentType": "Rooms",
        "SortOrder": 2,
        "Content": "Kitchen - 3.42m x 3.18m \r\nFitted Units\nwith Laminate wood floor\r\n\r\nLiving Room - 5.06m x 3.2m \r\nwith Fireplace\r\n\r\nBedroom 1 - 3.8m x 3.46m \r\nFitted Wardrobes\r\n\r\nBedroom 2 - 4.31m x 2.67m \r\nFitted Wardrobes\r\n\r\nBedroom 3 - 3.11m x 2.48m \r\n\r\n\r\nBathroom - 2.59m x 1.66m \r\nFully Tiled with electric shower, whb and wc\r\n\r\n"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Built 1955\r\nExtends to 86 sq. metres\r\nOil Fired Central Heating\r\nuPVC double glazed windows\r\nTwo Car parking spaces\r\nCentrally located to Naas Main Street\r\nLarge site with generous gardens\r\nObvious potential for extension\r\nCanal side walk within 50 metres"
      },
      {
        "ContentType": "BER Details",
        "SortOrder": 4,
        "Content": "BER: C"
      },
      {
        "ContentType": "Viewing Details",
        "SortOrder": 6,
        "Content": "Inspection By Appointment Only"
      }
