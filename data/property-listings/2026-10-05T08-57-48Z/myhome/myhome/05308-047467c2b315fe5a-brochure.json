    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "We are delighted to offer for sale this centrally located property on St. Lelia Street and within a couple of blocks of Limerick city centre and all its amenities.\r\n\r\nThe property whilst requiring some refurbishment offers the discerning purchaser an opportunity to create and put their own stamp on it.\r\n\r\nCurrent accommodation comprises of entrance hallway, living room, kitchen, at first floor level there are two double bedrooms and a bathroom and attic room at second floor level.\r\n\r\nThis sale will include all carpets, curtains, blinds, electric light fittings, oven, hob and extractor fan where applicable.\r\n\r\nOutside there is an enclosed walled rear courtyard and to the front there is street parking."
      },
      {
        "ContentType": "Rooms",
        "SortOrder": 2,
        "Content": "Entrance Hall - \r\n\r\n\r\nLiving Room - \r\n\r\n\r\nKitchen - \r\n\r\n\r\nFirst Floor - \r\n\r\n\r\nBathroom - \r\n\r\n\r\nBedroom 1 - \r\nBuilt in wardrobe.\r\n\r\nBedroom 2 - \r\nBuilt in wardrobe.\r\n\r\nSecond Floor - \r\n\r\n\r\nAttic - \r\n\r\n\r\nOutside - \r\nFully enclosed walled rear courtyard with garden shed.\r\n\r\n"
      },
