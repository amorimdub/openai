    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Parcel of Land for Sale Subject to the Purchaser Obtaining the Necessary Planning Permission\n\nCampbells Auctioneers are pleased to present this attractive parcel of land to the market, ideally located in Portnoo, just a short drive from Narin Village.\n\n\nExtending to approximately 1 acres, the property enjoys a peaceful and scenic setting.\n\n\nThe lands benefit from ample road frontage and offer good potential for construction of a dwelling, subject to planning permission.\n\nFor further information, please contact Campbells Auctioneers.\n\nOur Ref: K1242\n"
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Notice\nPlease note we have not tested any apparatus, fixtures, fittings, or services. Interested parties must undertake their own investigation into the working order of these items. All measurements are approximate and photographs provided for guidance only."
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "<ul><li> 1 Acre Approx. </li><li> Peaceful Scenic Location </li><li> Close to Narin Beach</li></ul>"
      },
      {
        "ContentType": "Negotiator",
        "SortOrder": 10,
        "Content": "Kenneth Campbell"
      }
    ],
