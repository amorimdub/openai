    "BrochureContent": [
      {
        "ContentType": "Description",
        "SortOrder": 0,
        "Content": "Gordon Hughes Estate Agents are delighted to bring to the rental market this spacious 3 bedroom semi-detached house which is in walk-in-condition throughout. This property is situated in a popular residential area on the outskirts of the thriving town of Ballinamore & is available to let either furnished or unfurnished. Within walking distance of all shops, services and schools the accommodation comprises of; Hallway, Living Room, Kitchen/Dining Room, WC, & Bathroom & No.3 Bedrooms (1 ensuite).  Strictly NO PETS. Viewing by Appointment Only with Sole Letting Agent. EMAIL ENQUIRIES ONLY."
      },
      {
        "ContentType": "Accommodation",
        "SortOrder": 1,
        "Content": "Hallway\r\nKitchen/dining room\r\nLiving Room (open fireplace)\r\nToilet\r\nBathroom\r\nNo.3 Beds (1 ensuite)"
      },
      {
        "ContentType": "Features",
        "SortOrder": 3,
        "Content": "Ready for immediate occupation\r\nClose to Ballinamore town centre"
      },
